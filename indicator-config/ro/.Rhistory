# Parcurge fiecare fișier și modifică conținutul
for (file in names(files_tags)) {
# Verifică dacă fișierul există
if (file.exists(file)) {
# Citește conținutul fișierului
content <- readLines(file)
# Înlocuiește rândul "tags: []" cu tag-ul specific
content <- gsub("tags: \\[\\]", files_tags[[file]], content)
# Scrie conținutul modificat înapoi în fișier
writeLines(content, file)
cat(sprintf("Modificat: %s\n", file))
} else {
cat(sprintf("Fișierul nu a fost găsit: %s\n", file))
}
}
cat("Procesul a fost finalizat!\n")
# Setează directorul de lucru unde se află fișierele
